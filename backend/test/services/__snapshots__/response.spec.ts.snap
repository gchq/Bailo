// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`services > response > checkAccessRequestsApproved > approved access request exists 1`] = `
[
  [
    [
      {
        "$match": {
          "accessRequestId": {
            "$in": [
              "access-1",
              "access-2",
            ],
          },
        },
      },
      {
        "$lookup": {
          "as": "latestDecisions",
          "from": "v2_responses",
          "let": {
            "reviewId": "$_id",
          },
          "pipeline": [
            {
              "$match": {
                "$expr": {
                  "$eq": [
                    "$parentId",
                    "$$reviewId",
                  ],
                },
                "kind": "review",
              },
            },
            {
              "$sort": {
                "createdAt": -1,
              },
            },
            {
              "$group": {
                "_id": "$entity",
                "decision": {
                  "$first": "$decision",
                },
              },
            },
            {
              "$group": {
                "_id": null,
                "decisions": {
                  "$addToSet": "$decision",
                },
              },
            },
          ],
        },
      },
      {
        "$addFields": {
          "reviewerDecisions": {
            "$ifNull": [
              {
                "$arrayElemAt": [
                  "$latestDecisions.decisions",
                  0,
                ],
              },
              [],
            ],
          },
        },
      },
      {
        "$group": {
          "_id": "$accessRequestId",
          "approvedReviews": {
            "$sum": {
              "$cond": [
                {
                  "$and": [
                    {
                      "$in": [
                        "approve",
                        "$reviewerDecisions",
                      ],
                    },
                    {
                      "$not": [
                        {
                          "$in": [
                            "request_changes",
                            "$reviewerDecisions",
                          ],
                        },
                      ],
                    },
                  ],
                },
                1,
                0,
              ],
            },
          },
          "totalReviews": {
            "$sum": 1,
          },
        },
      },
      {
        "$match": {
          "$expr": {
            "$eq": [
              "$approvedReviews",
              "$totalReviews",
            ],
          },
        },
      },
    ],
  ],
]
`;
