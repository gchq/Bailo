// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`services > response > checkAccessRequestsApproved > approved access request exists 1`] = `
[
  [
    [
      {
        "$match": {
          "accessRequestId": {
            "$in": [
              "access-1",
              "access-2",
            ],
          },
        },
      },
      {
        "$lookup": {
          "as": "responses",
          "from": "v2_responses",
          "let": {
            "reviewId": "$_id",
          },
          "pipeline": [
            {
              "$match": {
                "$expr": {
                  "$eq": [
                    "$parentId",
                    "$$reviewId",
                  ],
                },
                "kind": "review",
              },
            },
          ],
        },
      },
      {
        "$addFields": {
          "latestResponse": {
            "$arrayElemAt": [
              {
                "$sortArray": {
                  "input": "$responses",
                  "sortBy": {
                    "createdAt": -1,
                  },
                },
              },
              0,
            ],
          },
        },
      },
      {
        "$group": {
          "_id": "$accessRequestId",
          "approvedReviews": {
            "$sum": {
              "$cond": [
                {
                  "$eq": [
                    "$latestResponse.decision",
                    "approve",
                  ],
                },
                1,
                0,
              ],
            },
          },
          "totalReviews": {
            "$sum": 1,
          },
        },
      },
      {
        "$match": {
          "$expr": {
            "$eq": [
              "$approvedReviews",
              "$totalReviews",
            ],
          },
        },
      },
    ],
  ],
]
`;
