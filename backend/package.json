{
  "name": "@bailo/backend",
  "description": "",
  "keywords": [],
  "license": "ISC",
  "author": "",
  "type": "module",
  "scripts": {
    "build": "tsc && npm run copy-templates",
    "certs": "mkdir -p certs && openssl genrsa -out certs/key.pem 2048 && openssl req -new -x509 -key certs/key.pem -out certs/cert.pem -config certs/san.cnf -extensions 'v3_req' -days 360 && tsx src/scripts/generateJWKS.ts",
    "check-cycles": "madge --circular src",
    "check-cycles:types": "madge_detectiveOptions__ts__skipTypeImports= madge --circular src",
    "check-style": "prettier --check .",
    "copy-templates": "cd src && find . -name '*.hbs' | cpio -pdm ../dist/src",
    "dev": "nodemon",
    "generate-config-docs": "npx tsx src/scripts/generateConfigDocs.ts",
    "lint": "eslint --cache --cache-location node_modules/.cache/eslint/ --max-warnings=0",
    "script": "tsx src/scripts/runScript.ts",
    "seed": "tsx src/seeds/index.ts",
    "start": "tsx src/index.ts",
    "style": "prettier --write .",
    "test": "vitest"
  },
  "overrides": {
    "mv": "npm:dry-uninstall",
    "madge": {
      "typescript": "$typescript"
    }
  },
  "dependencies": {
    "@agendajs/mongo-backend": "^4.0.3",
    "@asteasolutions/zod-to-openapi": "^7.3.4",
    "@aws-sdk/client-cognito-identity-provider": "3.1152.0",
    "@aws-sdk/client-kms": "3.1152.0",
    "@aws-sdk/client-s3": "3.1152.0",
    "@aws-sdk/client-sesv2": "3.1152.0",
    "@aws-sdk/lib-storage": "3.1152.0",
    "@aws-sdk/middleware-flexible-checksums": "^3.974.58",
    "@huggingface/hub": "^2.17.8",
    "@opentelemetry/auto-instrumentations-node": "^0.81.2",
    "@opentelemetry/exporter-logs-otlp-proto": "^0.223.0",
    "@opentelemetry/exporter-metrics-otlp-proto": "^0.223.0",
    "@opentelemetry/host-metrics": "^0.39.0",
    "@opentelemetry/sdk-metrics": "^2.10.0",
    "@smithy/node-http-handler": "^4.0.4",
    "agenda": "^6.2.5",
    "bcryptjs": "^3.0.3",
    "bytes": "^3.1.2",
    "clamscan": "^2.4.0",
    "config": "^5.0.1",
    "connect-mongo": "^6.0.0",
    "express": "5.3.0",
    "express-rate-limit": "^8.7.1",
    "express-session": "^1.19.0",
    "form-data": "^4.0.6",
    "grant": "^5.4.23",
    "handlebars": "^4.7.10",
    "helmet": "^8.2.0",
    "human-interval": "^2.0.1",
    "json-schema-traverse": "^1.0.0",
    "jsonschema": "^1.5.0",
    "jsonwebtoken": "^9.0.3",
    "lodash-es": "^4.18.1",
    "marked": "^18.1.1",
    "mjml": "5.4.1",
    "mongodb": "^7.7.0",
    "mongoose": "^9.11.2",
    "node-cache": "^5.1.2",
    "node-fetch": "^3.3.2",
    "nodemailer": "^10.1.4",
    "p-queue": "^10.0.0",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "pino-opentelemetry-transport": "^4.0.2",
    "proxy-agent": "^8.0.2",
