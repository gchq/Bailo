    "semver": "^7.8.1",
    "shelljs": "^0.10.0",
    "swagger-ui-express": "^5.0.1",
    "tar-stream": "^3.2.2",
    "tsx": "^4.23.15",
    "undici": "^8.12.2",
    "xmlbuilder2": "^4.0.3",
    "yargs": "^18.2.0",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@anatine/zod-mock": "^3.14.0",
